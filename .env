# ==============================================================
# Entregas 1 y 2 - Usuarios, perfiles, conteo y matrices
# ==============================================================
USER_FILE=USUARIOS.TXT
PERFIL_FILE=PERFILES.TXT
DEFAULT_TEXT_FILE=LIBROS/drama_don_quijote_de_la_mancha_cervantes.txt
# Programas externos llamados desde el MENU PRINCIPAL (llamada a sistema)
# Opcion 1: programa de la Entrega 1 (Administracion de usuarios y perfiles)
ADMIN_EXEC=admin_usuarios.exe
# Opcion 2: programa multiplicador de matrices (Entrega 2)
MATRIX_EXEC=multi.exe

# ==============================================================
# Entrega 3 - Problema 1: Indice invertido concurrente
# ==============================================================
# Opcion 8: La opcion 8 del menú llama a indice_invertido.exe por llamada a sistema
INDEX_EXEC=indice_invertido.exe|
# Archivo de salida del indice invertido
INVERTED_INDEX_FILE=indice_invertido.idx
# Archivo con la asociacion  ID;nombre_del_libro
BOOK_MAP_FILE=libros_mapeo.txt
# Carpeta con los libros a procesar
BOOKS_DIR=LIBROS
# Cantidad de threads trabajadores (entero entre 1 y 1024)
N_THREADS=4

# ==============================================================
# Entrega 3 - Problema 2: Juego multiplayer mediante sockets
# ==============================================================
# Conexion (el servidor escucha en GAME_PORT en todas las interfaces;
# los clientes se conectan a GAME_SERVER_IP:GAME_PORT)
GAME_SERVER_IP=127.0.0.1
GAME_PORT=8080
# Archivo de log del servidor
GAME_LOG_FILE=juego.log
# Ejecutable del servidor (lo usa la opcion 3 -> 2 del menu)
GAME_SERVER_EXEC=juego_server.exe
# Ejecutable del cliente del juego (opcion 3 -> 1 del menu)
GAME_CLIENT_EXEC=juego_cliente.exe
# Reglas: tablero de X posiciones y dado de R caras
GAME_BOARD_SIZE=30
GAME_DICE_FACES=6
# Jugadores y equipos
GAME_MIN_PLAYERS=2
GAME_MAX_PLAYERS=8
GAME_MIN_TEAMS=2
GAME_MAX_TEAMS=4
GAME_MIN_PLAYERS_PER_TEAM=1
GAME_MAX_PLAYERS_PER_TEAM=2
# Segundos para lanzar en cada turno (0 = sin limite)
GAME_TURN_TIMEOUT=60
